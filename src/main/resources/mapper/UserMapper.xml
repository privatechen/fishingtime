<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fishingtime.user.mapper.UserMapper">

    <resultMap id="userResultMap" type="User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="nickname" property="nickname"/>
        <result column="email" property="email"/>
        <result column="openid" property="openid"/>
        <result column="avatar_url" property="avatarUrl"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <sql id="baseColumns">
        id, username, nickname, email, openid, avatar_url, status, created_at, updated_at
    </sql>

    <insert id="insertUser" parameterType="User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (username, password, nickname, email, openid, avatar_url, status)
        VALUES (#{username}, #{password}, #{nickname}, #{email}, #{openid}, #{avatarUrl}, #{status})
    </insert>

    <select id="selectByUsername" resultMap="userResultMap">
        SELECT id, username, password, nickname, email, openid, avatar_url, status, created_at, updated_at
        FROM user
        WHERE username = #{username}
    </select>

    <select id="selectByOpenid" resultMap="userResultMap">
        SELECT <include refid="baseColumns"/>
        FROM user
        WHERE openid = #{openid}
    </select>

    <select id="selectById" resultMap="userResultMap">
        SELECT <include refid="baseColumns"/>
        FROM user
        WHERE id = #{id}
    </select>

    <update id="updateProfile" parameterType="com.fishingtime.user.domain.User">
        UPDATE user
        SET username = #{username},
            nickname = #{nickname},
            email = #{email}
        WHERE id = #{id}
    </update>
</mapper>